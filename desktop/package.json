{
  "name": "markdown-previewer-desktop",
  "productName": "Folio",
  "version": "0.7.0",
  "private": true,
  "description": "Desktop app for browsing and reading a folder of Markdown files",
  "author": "Alexei Pogrebtsov",
  "license": "MIT",
  "main": "dist/desktop/src/main.js",
  "scripts": {
    "build:renderer": "npm --prefix ../frontend run build && node scripts/copy-renderer.mjs",
    "build:main": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "demo:bundle": "npm run build:main && node scripts/demo-bundle.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "dev": "npm run build:main && VITE_DEV_SERVER_URL=http://localhost:3000 electron .",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "test": "vitest run"
  },
  "build": {
    "appId": "dev.pogrebtsov.folio",
    "productName": "Folio",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "crazzybot",
      "repo": "folio",
      "releaseType": "draft"
    },
    "files": [
      "dist/**",
      "renderer/**",
      "package.json"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Folder",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.folder"
            ]
          }
        ]
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64", "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64", "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
